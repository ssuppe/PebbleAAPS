{
  "name": "pebble-aaps",
  "author": "Soopaloop",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "pebble-scalable": "^2.3.0"
  },
  "pebble": {
    "displayName": "PebbleAAPS",
    "uuid": "54d3008f-e144-4712-b201-24bc515c40ba",
    "sdkVersion": "3",
    "enableMultiJS": false,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery"
    ],
    "screenshots": {
      "emery": [
        "resources/screenshots/emery_screenshot.png"
      ],
      "basalt": [
        "resources/screenshots/basalt_screenshot.png"
      ],
      "chalk": [
        "resources/screenshots/chalk_screenshot.png"
      ],
      "diorite": [
        "resources/screenshots/diorite_screenshot.png"
      ]
    },
    "watchapp": {
      "watchface": true,
      "appIcon": "APP_DEMO_ICON"
    },
    "messageKeys": {
      "BG": 0,
      "TREND": 1,
      "IOB": 2,
      "COB": 3,
      "TIME": 4,
      "BASAL": 5,
      "IOB_DETAIL": 6,
      "DELTA": 7,
      "AVG_DELTA": 8,
      "GLUCOSE_HISTORY": 9,
      "LOW_TARGET": 10,
      "HIGH_TARGET": 11,
      "UNITS": 12
    },
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "APP_DEMO_ICON",
          "file": "images/watchface_icon.png",
          "menuIcon": true
        },

        {
          "type": "png",
          "name": "ARROW_NONE",
          "file": "images/arrow_none.png"
        },
        {
          "type": "png",
          "name": "ARROW_TRIPLE_UP",
          "file": "images/arrow_triple_up.png"
        },
        {
          "type": "png",
          "name": "ARROW_DOUBLE_UP",
          "file": "images/arrow_double_up.png"
        },
        {
          "type": "png",
          "name": "ARROW_SINGLE_UP",
          "file": "images/arrow_single_up.png"
        },
        {
          "type": "png",
          "name": "ARROW_FORTY_FIVE_UP",
          "file": "images/arrow_forty_five_up.png"
        },
        {
          "type": "png",
          "name": "ARROW_FLAT",
          "file": "images/arrow_flat.png"
        },
        {
          "type": "png",
          "name": "ARROW_FORTY_FIVE_DOWN",
          "file": "images/arrow_forty_five_down.png"
        },
        {
          "type": "png",
          "name": "ARROW_SINGLE_DOWN",
          "file": "images/arrow_single_down.png"
        },
        {
          "type": "png",
          "name": "ARROW_DOUBLE_DOWN",
          "file": "images/arrow_double_down.png"
        },
        {
          "type": "png",
          "name": "ARROW_TRIPLE_DOWN",
          "file": "images/arrow_triple_down.png"
        },
        {
          "type": "font",
          "name": "FONT_LILITA_22",
          "file": "fonts/LilitaOne-Regular.ttf",
          "characterRegex": "[0-9\\.\\+\\-\\(\\)\\|>\\'? a-zA-Z]"
        },
        {
          "type": "font",
          "name": "FONT_LILITA_32",
          "file": "fonts/LilitaOne-Regular.ttf",
          "characterRegex": "[0-9\\. Ug]"
        },
        {
          "type": "font",
          "name": "FONT_LILITA_48",
          "file": "fonts/LilitaOne-Regular.ttf",
          "characterRegex": "[0-9\\.\\-]"
        }
      ]
    }
  }
}
